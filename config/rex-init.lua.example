-- Add to ~/.config/rex/init.lua
-- Ensure Rex Settings -> Terminal -> Selection -> Copy on Selection is enabled.

local rexplain_root = (os.getenv("HOME") or "") .. "/github/rexplain"
package.path = package.path .. ";" .. rexplain_root .. "/adapters/rex/?.lua"
local rexplain = require("rexplain")

